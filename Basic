#Execption Handling

#Code without exeption handling
def spam(divideBy):
    return 42 / divideBy
    
print(spam(2))
print(spam(12))
print(spam(0))
print(spam(1))

#Code with exception handling
def spam(divideBy):
    try:
        return 42 / divideBy
    except ZeroDivisionError:
        print('Error: Invalid argument')
        
print(spam(2))
print(spam(12))
print(spam(0))
print(spam(1))

#or

#Code with exception handling
def spam(divideBy):
    return 42 / divideBy
    
try:
    print(spam(2))
    print(spam(12))
    print(spam(0))
    print(spam(1))
except ZeroDivisionError:
    print('Error: Invalid argument')

